# Use a read-only TronGrid key. Never commit a real key.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
PROVIDER_RETRY_ATTEMPTS=4
PROVIDER_RETRY_BACKOFF_SECONDS=1.0
ETHERSCAN_MIN_INTERVAL_SECONDS=0.38
DATABASE_PATH=vasp_trace.db
TRACE_MAX_HOPS=3
TRACE_MAX_WALLETS=16
TRACE_MAX_PROVIDER_PAGES=5
PROVIDER_CACHE_SECONDS=300
TRONGRID_TIMEOUT_SECONDS=12
# Optional production-style access control: comma-separated investigator_id:secret:role records.
# Example: INVESTIGATOR_API_KEYS=cyber-hyd:replace-with-long-secret:investigator
INVESTIGATOR_API_KEYS=
REQUESTS_PER_MINUTE=120
